{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bowen-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bowen-web"
    }
  ],
  "routes": [
    {
      "pattern": "vitoshow.site",
      "zone_name": "vitoshow.site",
      "custom_domain": true
    },
    {
      "pattern": "www.vitoshow.site",
      "zone_name": "vitoshow.site",
      "custom_domain": true
    }
  ]
}
